# ChainMail Council — environment variables
# Copy to .env and fill in values

# Supabase (boardroom edge function)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
BOARDROOM_URL=https://emyiiapbjrijawaejcxd.supabase.co/functions/v1/boardroom

# OpenAI — used by JetBrains MCP layer (Codex orchestration + code fix generation)
OPENAI_API_KEY=your_openai_api_key_here

# Nebius — Token Factory MoE models (set in Supabase edge function secrets, not here)
# NEBIUS_API_KEY=set_in_supabase_secrets

# Bkey enforcement (0 = warn-only dev mode, 1 = hard block without hardware key)
REQUIRE_BKEY=0

# Optional: pin a session ID across CLI invocations
# COUNCIL_SESSION=my-session-id
